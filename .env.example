# Site URL used for canonical links, Open Graph URLs and the sitemap.
# Set this to the production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://basavalingaavadhoota.org

# --- Contact form delivery (optional) ---------------------------------------
# A JSON POST endpoint that receives contact enquiries (Zapier, Make, n8n,
# Google Apps Script, or your own CRM). When unset, enquiries are appended to
# data/contact-submissions.ndjson on the server (self-hosted deployments).
CONTACT_WEBHOOK_URL=

# --- Donation and book request delivery (optional) -------------------------
# JSON POST endpoints for giving requests and book orders. When unset, each
# request is appended to a private NDJSON file under data/ on self-hosted
# servers. Both fall back to CONTACT_WEBHOOK_URL if only that is set.
DONATION_WEBHOOK_URL=
BOOK_ORDER_WEBHOOK_URL=

# --- Admin studio (required for /admin) ------------------------------------
# The office email and a strong password. If ADMIN_EMAIL is omitted, the site's
# public office email is used. Generate a session secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=basavalingavadhoot@gmail.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Prokerala panchang (optional, for live astrological data) --------------
# Create OAuth client credentials at https://api.prokerala.com. When these are
# present, today's panchang and day-detail requests use Prokerala; when absent,
# the calendar calculates an approximate panchang locally in IST.
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# --- Persistent content storage (required on Vercel) ----------------------
# Create a Vercel Blob store and connect it to the project. This single token
# persists events, uploaded gallery images and the private member list across
# deployments. On a self-hosted Node server, leave it empty to use data/ and
# public/uploads/.
BLOB_READ_WRITE_TOKEN=

# --- SMS and WhatsApp delivery (choose one approach) ----------------------
# Option A: Twilio, for direct delivery of receipts and event alerts.
# TWILIO_WHATSAPP_FROM must be a WhatsApp-enabled sender, for example
# whatsapp:+14155238886. Indian SMS delivery may require DLT registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Option B: a JSON webhook that receives every message and event broadcast.
# The automation behind it can deliver SMS/WhatsApp through your preferred
# provider. Used when Twilio is not fully configured.
NOTIFICATION_WEBHOOK_URL=
